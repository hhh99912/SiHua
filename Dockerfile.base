FROM node:22.21.1-slim

# 1. 安装基础图形库、Mesa 软渲染、中英文字体、Fcitx 模块与字体配置工具
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libgtk-3-0 libnss3 libxss1 libxtst6 xdg-utils libnotify4 \
    libatspi2.0-0 libuuid1 libsecret-1-0 libappindicator3-1 libx11-xcb1 \
    libxcb1 libxcomposite1 libxcursor1 libxdamage1 libxext6 libxfixes3 \
    libxi6 libxrandr2 libxrender1 libasound2 libpulse0 libgbm1 libdrm2 \
    ca-certificates fontconfig libfreetype6 \
    fonts-wqy-microhei fonts-wqy-zenhei \
    libgl1-mesa-dri \
    fcitx-frontend-gtk3 \
    libgtk-3-bin \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /usr/share/doc/* /usr/share/man/*

# 2. 刷新 GTK3 输入法识别缓存
RUN gtk-query-immodules-3.0 --update-cache 2>/dev/null || true

# 3. 写入针对工业大屏与中文字体清晰度极致优化的 local.conf
RUN mkdir -p /etc/fonts && echo '<?xml version="1.0"?>' > /etc/fonts/local.conf && \
    echo '<!DOCTYPE fontconfig SYSTEM "fonts.dtd">' >> /etc/fonts/local.conf && \
    echo '<fontconfig>' >> /etc/fonts/local.conf && \
    echo '  <!-- 核心清晰度优化: 开启RGB次像素LCD渲染与中等物理网格微调 -->' >> /etc/fonts/local.conf && \
    echo '  <match target="font">' >> /etc/fonts/local.conf && \
    echo '    <edit mode="assign" name="antialias"><bool>true</bool></edit>' >> /etc/fonts/local.conf && \
    echo '    <edit mode="assign" name="hinting"><bool>true</bool></edit>' >> /etc/fonts/local.conf && \
    echo '    <edit mode="assign" name="autohint"><bool>false</bool></edit>' >> /etc/fonts/local.conf && \
    echo '    <edit mode="assign" name="hintstyle"><const>hintmedium</const></edit>' >> /etc/fonts/local.conf && \
    echo '    <edit mode="assign" name="rgba"><const>rgb</const></edit>' >> /etc/fonts/local.conf && \
    echo '    <edit mode="assign" name="lcdfilter"><const>lcddefault</const></edit>' >> /etc/fonts/local.conf && \
    echo '  </match>' >> /etc/fonts/local.conf && \
    echo '  <!-- 默认通用字体族精准重定向至高质量中文字体 -->' >> /etc/fonts/local.conf && \
    echo '  <alias><family>sans-serif</family><prefer><family>WenQuanYi Micro Hei</family><family>WenQuanYi Zen Hei</family></prefer></alias>' >> /etc/fonts/local.conf && \
    echo '  <alias><family>system-ui</family><prefer><family>WenQuanYi Micro Hei</family><family>WenQuanYi Zen Hei</family></prefer></alias>' >> /etc/fonts/local.conf && \
    echo '  <alias><family>monospace</family><prefer><family>WenQuanYi Micro Hei Mono</family><family>WenQuanYi Zen Hei Mono</family></prefer></alias>' >> /etc/fonts/local.conf && \
    echo '</fontconfig>' >> /etc/fonts/local.conf

# 4. 刷新字体缓存
RUN fc-cache -fv

# 5. 核心全局环境变量：指定 FreeType 使用 v40 亚像素渲染引擎 (彻底消除毛刺与虚影)
ENV FREETYPE_PROPERTIES="truetype:interpreter-version=40 cff:no-stem-darkening=0 type1:no-stem-darkening=0"
ENV LANG="C.UTF-8"
ENV LC_ALL="C.UTF-8"

WORKDIR /app
