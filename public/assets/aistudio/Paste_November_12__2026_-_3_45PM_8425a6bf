    void MainView::print()
    {
        m_CurrentTabOrder = tab->currentIndex();
        if (m_CurrentTabOrder >= 0)
        {
            CWarnSplitterMap::Iterator it;
            it = m_WarnSplitterMap.find(m_CurrentTabOrder);
            if (it != m_WarnSplitterMap.end())
