    MainView::MainView(QWidget *parent) : BaseMainWindow(parent)
    {
        QPalette palette;
        palette.setBrush(QPalette::Background, QBrush(QColor(220, 220, 220)));
        setPalette(palette);
        initData();
        setAnimated(true);

        tab = new QTabWidget;
        if (tab_position)
            tab->setTabPosition(QTabWidget::North);
        else
            tab->setTabPosition(QTabWidget::South);
        tab->setTabShape(QTabWidget::Triangular);
        connect(tab, SIGNAL(currentChanged(int)), this, SLOT(tabChanged(int)));

        initTab();
        setCentralWidget(tab);

        createActions();
        if (if_show_menu)
        {
            createMenus();
        }
        createToolBars();
        createStatusBar();
        // createDockWindows();
        setWindowTitle(QObject::tr("Alarming window", "告警窗"));
        setWindowFlags((windowFlags() & ~Qt::WindowCloseButtonHint) | Qt::CustomizeWindowHint | Qt::WindowTitleHint | Qt::WindowMinMaxButtonsHint);
        timer.start(INTERVAL_TIME, this);
        setGeometry(0, 5, WIN_WIDTH, 450);
        setMinimumWidth(WIN_WIDTH * 3 / 4);
        setMaximumSize(WIN_WIDTH, WIN_HEIGHT);

        m_pTimer = new QTimer();
        m_pTimer->setInterval(1000);
        connect(m_pTimer, SIGNAL(timeout()), this, SLOT(slot_timer_out()), Qt::DirectConnection);
        m_pTimer->start();
    }

    MainView::~MainView()
    {
        if (m_WarnRecMessage)
        {
            delete[] m_WarnRecMessage;
            m_WarnRecMessage = NULL;
        }
        if (m_OneFacBayInfoArray)
        {
            delete[] m_OneFacBayInfoArray;
            m_OneFacBayInfoArray = NULL;
        }
        if (FacInfoArray)
        {
            delete[] FacInfoArray;
            FacInfoArray = NULL;
        }
        if (BayInfoArray)
        {
            delete[] BayInfoArray;
            BayInfoArray = NULL;
        }
        if (m_ValueBuffer)
        {
            for (int i = 0; i < WarnTableDes.field_sum; i++)
                if (m_ValueBuffer[i])
                    delete[] m_ValueBuffer[i];
            delete[] m_ValueBuffer;
        }
    }

