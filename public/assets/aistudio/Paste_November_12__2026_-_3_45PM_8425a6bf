    void MainView::timerEvent(QTimerEvent *event)
    {
        if (event->timerId() != timer.timerId())
        {
            return QWidget::timerEvent(event);
        }
        mytimer++;
        if (mytimer % 10 == 0)
        {
            /*
            if(theDock->isHidden()){
                showDockAct->setChecked(false);
            }
            */

            time_t aa;
            time(&aa);
            int tmp, i, j;
            int begin = 0, end = item_end;
            if (item_has_full == 1)
            {
                if (item_end == 0)
                {
                    begin = 0;
                    end = MAX_LINES;
                }
                else
                {
                    begin = item_end;
                    end = begin + MAX_LINES;
                }
            }
            for (i = begin; i < end; i++)
            {
                j = i % MAX_LINES;
                if (WarnDefine[ShowArray[m_WarnRecMessage[j].type]].flag == 0)
                    continue;
                if ((aa - m_WarnRecMessage[j].start_time > WarnDefine[ShowArray[m_WarnRecMessage[j].type]].stop_flash) && (WarnDefine[ShowArray[m_WarnRecMessage[j].type]].stop_flash > 0) && (m_WarnRecMessage[j].start_time > 0) && (m_WarnRecMessage[j].flag == 2))
                {
                    m_WarnRecMessage[j].confirm = 1;
                    refresh_flag = 1; // zq add
                }
            }

            if (tl_flag)
            {
                // 故障智能推理
                for (i = end - 1; i >= begin; i--)
                {
                    j = (i + MAX_LINES) % MAX_LINES;
                    // 线路保护动作信号，启动线路故障推理
                    if (!strstr(m_WarnRecMessage[j].string, "SOE") && m_WarnRecMessage[j].value == 1 &&
                        (((m_WarnRecMessage[j].repostype == REPOS_XLBH || m_WarnRecMessage[j].repostype == REPOS_CHZ) && m_WarnRecMessage[j].type == WARN_TYPE_YX_BW)))
                    {
                        m_WarnRecMessage[j].gztype = GZ_XLCG;
                        printf("启动线路故障推理:%d,%s\n", j, m_WarnRecMessage[j].string);
                        xl_gz_flag = j;
                    }

                    // 母线保护动作信号，启动母线故障推理
                    if (!strstr(m_WarnRecMessage[j].string, "SOE") && m_WarnRecMessage[j].value == 1 &&
                        ((m_WarnRecMessage[j].repostype == REPOS_MXBH && m_WarnRecMessage[j].type == WARN_TYPE_YX_BW)))
                    {
                        m_WarnRecMessage[j].gztype = GZ_MX;
                        printf("启动母线故障推理:%d,%s\n", j, m_WarnRecMessage[j].string);
                        mx_gz_flag = j;
                    }

                    // 主变PT断线动作信号，启动主变PT断线故障推理
                    if (!strstr(m_WarnRecMessage[j].string, "SOE") && m_WarnRecMessage[j].value == 1 &&
                        ((m_WarnRecMessage[j].repostype == REPOS_ZBPTDX && m_WarnRecMessage[j].type == WARN_TYPE_YX_BW)))
                    {
                        m_WarnRecMessage[j].gztype = GZ_ZBPTDX;
                        printf("启动主变PT断线故障推理:%d,%s\n", j, m_WarnRecMessage[j].string);
