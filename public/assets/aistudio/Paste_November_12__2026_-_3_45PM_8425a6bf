    int MainView::OnSendReportToNsPanel(int process_state)
    {
        int process_id;
        char *buffer = NULL;
        int buffer_length = 0, counter = 0;
        char process_cmd_name[32];
        char process_log_name[32];
        char process_title[64];

        process_id = getpid();
        strcpy(process_cmd_name, "gui_warn");
        strcpy(process_log_name, "Warn");
        GetStrFromQStr(tr("Smart warn", "智能告警窗"), process_title, 64);

        buffer_length = sizeof(int);
        buffer = (char *)malloc(buffer_length);
        memcpy(buffer, &process_id, sizeof(int));
        counter += sizeof(int);

        buffer_length = 32;
        buffer = (char *)realloc(buffer, buffer_length + counter);
        memcpy(buffer + counter, process_cmd_name, 32);
        counter += 32;

        buffer_length = 32;
        buffer = (char *)realloc(buffer, buffer_length + counter);
        memcpy(buffer + counter, process_log_name, 32);
        counter += 32;

        buffer_length = 64;
        buffer = (char *)realloc(buffer, buffer_length + counter);
        memcpy(buffer + counter, process_title, 64);
        counter += 64;

        buffer_length = sizeof(int);
        buffer = (char *)realloc(buffer, buffer_length + counter);
        memcpy(buffer + counter, &process_state, sizeof(int));
        counter += sizeof(int);

        int screen_number = qApp->desktop()->screenNumber();
        buffer_length = sizeof(int);
        buffer = (char *)realloc(buffer, buffer_length + counter);
        memcpy(buffer + counter, &screen_number, sizeof(int));
        counter += sizeof(int);

        smart_warn_info.dnet_send_message(
            DNET_REPORT_BROADCAST_SAFE,
            DNET_APP_TO_PANEL,
            DNET_LOCAL_HOST,
            "nspanel",
            buffer, counter);
        free(buffer);
        return 0;
    }

    void MainView::resizeEvent(QResizeEvent *event)
    {
        if (event->size().height() >= WIN_HEIGHT)
        {
            if (event->size().width() >= WIN_WIDTH)
            {
                m_ProcessState = PROCESS_STATE_MAXIMIZE;
                move(0, 0);
            }
            else
            {
                move(pos().x(), 0);
            }
        }
        return QMainWindow::resizeEvent(event);
    }

    bool MainView::event(QEvent *event)
    {
        if (m_ProcessState == PROCESS_STATE_CLOSE)
            return QMainWindow::event(event);

        switch (event->type())
        {
        case QEvent::WindowActivate:
            m_ProcessState = PROCESS_STATE_ACTIVE;
            //			OnSendReportToNsPanel(m_ProcessState);
            return QMainWindow::event(event);
            break;
        case QEvent::WindowDeactivate:
            m_ProcessState = PROCESS_STATE_INACTIVE;
            //			OnSendReportToNsPanel(m_ProcessState);
            return QMainWindow::event(event);
            break;
        case QEvent::WindowStateChange:
            if (isMinimized())
                m_ProcessState = PROCESS_STATE_MINIMIZE;
            if (isMaximized())
                m_ProcessState = PROCESS_STATE_MAXIMIZE;
            //			OnSendReportToNsPanel(m_ProcessState);
            return QMainWindow::event(event);
            break;
        case QEvent::WindowTitleChange:
            m_ProcessState = PROCESS_UPDATE_TITLE;
            OnSendReportToNsPanel(m_ProcessState);
            return QMainWindow::event(event);
            break;
        case QEvent::Close:
            m_ProcessState = PROCESS_STATE_CLOSE;
            OnSendReportToNsPanel(m_ProcessState);
            return QMainWindow::event(event);
            break;
        default:
            break;
        }
        return QMainWindow::event(event);
    }

