                CWarnSplitterMap::Iterator it;
                it = m_WarnSplitterMap.find(m_CurrentTabOrder);
                if (it != m_WarnSplitterMap.end())
                {
                    if (if_split_win)
                        it.value()->m_allView->resize1();
                    it.value()->m_ackView->resize1();
                    warnsplit = it.value();
                }
                refresh_flag = 0;
            }

            if (!(show_ack_view && warnsplit->m_ackView->isVisible()))
            {
                emit showAckView(show_ack_view);
            }

            if (if_split_win)
            {
                if (!(show_all_view && warnsplit->m_allView->isVisible()))
                {
                    emit showAllView(show_all_view);
                }
            }

            int tmp, i, j, k, m;
            int begin = 0, end = item_end;
            if (item_has_full == 1)
            {
                if (item_end == 0)
                {
                    begin = 0;
                    end = MAX_LINES;
                }
                else
                {
                    begin = item_end;
                    end = begin + MAX_LINES;
                }
            }
            // 找出复归信号之前的动作,将其的fg_flag设为1
            for (i = end - 1; i >= begin; i--)
            {
                j = (i + MAX_LINES) % MAX_LINES;
                if (m_WarnRecMessage[j].value == 0 && !strstr(m_WarnRecMessage[j].string, "SOE"))
                {
                    for (k = i - 1; k >= begin; k--)
                    {
                        m = k % MAX_LINES;
                        if (m_WarnRecMessage[m].type == WARN_TYPE_YX_BW &&
                            m_WarnRecMessage[m].fac_id == m_WarnRecMessage[j].fac_id &&
                            m_WarnRecMessage[m].key_id == m_WarnRecMessage[j].key_id &&
                            m_WarnRecMessage[m].field_id == m_WarnRecMessage[j].field_id)
                        {
                            m_WarnRecMessage[m].fg_flag = 1;
                            // break;
                        }
                    }
                }
            }
            // 用户指定提示信息发生过m_InfoRepeatNums次就自动转为告警消息
            for (i = end - 1; i >= begin; i--)
            {
                int count = 0;
                j = (i + MAX_LINES) % MAX_LINES;
                if (m_WarnRecMessage[j].type != WARN_TYPE_YX_BW &&
                    m_WarnRecMessage[j].type != WARN_TYPE_YX_EVENT &&
                    m_WarnRecMessage[j].type != WARN_TYPE_YC_OVER_LIMIT)
                    continue;
                if (m_WarnRecMessage[j].customized_group == 1
                    //&&strstr(tmpwarn.string,"动作")
                )
                {
                    for (k = i - 1; k >= begin; k--)
                    {
                        m = k % MAX_LINES;
                        if (m_WarnRecMessage[m].type == m_WarnRecMessage[j].type &&
                            m_WarnRecMessage[m].fac_id == m_WarnRecMessage[j].fac_id &&
                            m_WarnRecMessage[m].key_id == m_WarnRecMessage[j].key_id &&
                            m_WarnRecMessage[m].field_id == m_WarnRecMessage[j].field_id)

                        {
                            if (m_WarnRecMessage[m].level == WARN_LEVEL_2)
                                break;
                            count++;
                            if (count >= m_InfoRepeatNums && m_InfoRepeatNums > 0)
                            {
                                // 超过指定次数自动转成告警消息
                                // qDebug(QString("提示信息自动转告警:%1").arg(m_WarnRecMessage[j].string));
                                m_WarnRecMessage[j].customized_group = WARN_LEVEL_2;
                                m_WarnRecMessage[j].level = WARN_LEVEL_2;
                                break;
                            }
                        }
                    }
                }
                if (j == processed_num)
                    break;
            }
        }

        if (mytimer % m_iShowInterval == 0)
        {
            m_bcolorflag = !m_bcolorflag;
            if (m_NoConfirmStyle)
            {
                if (m_bRefreshWarn)
                {
                    m_CurrentTabOrder = tab->currentIndex();
                    CWarnSplitterMap::Iterator it;
                    it = m_WarnSplitterMap.find(m_CurrentTabOrder);
                    if (it != m_WarnSplitterMap.end())
                    {
                        if (if_split_win)
                            it.value()->m_allView->Repaint1();
                        it.value()->m_ackView->Repaint1();
                        warnsplit = it.value();
                    }
                }
            }
        }

        if (mytimer % 20 == 0)
        {
            int count1 = GetCount1();
            int count2 = GetCount2();
            int count3 = GetCount3();
            countStr = tr("  Unconfirmed %1 record  Confirmed %2 record NotNeedConfirm %3 record", "  未确认%1条  已确认%2条  无需确认%3条").arg(count1, 4, 10, QChar('0')).arg(count2, 4, 10, QChar('0')).arg(count3, 4, 10, QChar('0'));
            countLabel->setText(countStr);
            if (!m_bRefreshWarn)
            {
                statusStr = tr("<font color='#ff0000'> stop to refresh!</font>", "<font color='#ff0000'> 已停止刷新!</font>");
                if (m_FacHadHold || m_BayHadHold)
                {
                    statusStr += tr("<font color='#ff0000'> has been set for shielding!</font>", "<font color='#ff0000'> 已设置屏蔽!</font>");
                }
                statusLabel->setText(statusStr);
                statusLabel->show();
            }
            else
            {
                statusStr.clear();
                statusLabel->hide();
                if (m_FacHadHold || m_BayHadHold)
                {
                    statusStr = tr("<font color='#ff0000'> has been set for shielding!</font>", "<font color='#ff0000'> 已设置屏蔽!</font>");
                    statusLabel->show();
                }
                statusLabel->setText(statusStr);
            }
            for (int ii = 0; ii < MAX_TABPAGE_NUM; ii++)
            {
                if (m_TabNeedLight[ii])
                {
                    tab->setTabIcon(ii, QIcon(QString(":light-on.png")));
                }
                else
                {
                    tab->setTabIcon(ii, QIcon(QString(":light-off.png")));
                }
            }
            if (select_flag)
            {
                //            QString text;
                //            makeText(text);
                //            tv->setText(text);
                select_flag = false;
                // update by sunzhibin
                if (if_split_win)
                    warnsplit->m_allView->Repaint1();
                warnsplit->m_ackView->Repaint1();
            }
            m_UserLoginFlag = UpdatePriv();
            if (m_UserLoginFlag)
                setActionState(true);
            else
                setActionState(false);
        }
        struct app_buf_head AHead;
        char *buffer;
        buffer = (char *)malloc(1);
        int ret = smart_warn_info.dnet_receive_message(AHead, buffer);
        if (ret >= 0)
        {
            // 此处标记程序已经接收到第一条消息
            m_FirstStart = false;
            /*
            if (AHead.rhead.report_type==DNET_DB_WARN_BROWSE_ANSWER)
            {
                getBuf.set_buf_byte_order(AHead);
                explainRecallReport(buffer);
                OnSendMsgToNsPanel();
            }
            */
            if (AHead.rhead.report_type == DNET_SEND_MESSAGE_TO_WARN)
            {
                getBuf.set_buf_byte_order(AHead);
                explainReport(buffer);
                OnSendMsgToNsPanel();
            }
            if (AHead.rhead.report_type == DNET_YX_UNFLASH)
            {
                getBuf.set_buf_byte_order(AHead);
                un_flash(buffer);
            }
            if (AHead.rhead.report_type == DNET_PANEL_ASK_APP)
            {
                getBuf.set_buf_byte_order(AHead);
                OnProcessAppAskProcess(buffer);
            }
        }
        free(buffer);

        if (refresh_window == 0)
            OnSendReportToNsPanel(m_ProcessState); // 每5分钟发一次
        refresh_window = (refresh_window + 1) % 6000;
    }

