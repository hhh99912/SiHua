    // 间隔多事件自动推理
    void MainView::AutoReposMulti(int id)
    {
        printf("当前消息ID为%d reposno=%d\n", id, m_WarnRecMessage[id].reposno);
        if (id < 0)
            return;
        if (m_WarnRecMessage[id].value != 1)
            return;
        if (m_WarnRecMessage[id].reposno > 2)
        {
            single_mul = 2; // 多重推理
            ReposInfo *myReposInfo = new ReposInfo(id, 1);
            delete myReposInfo;
        }
        return;
    }

