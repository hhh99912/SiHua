    void MainView::initTab()
    {
        int i;
        tabpages_num = 0;
        TABPAGE_NAME[tabpages_num] = TABPAGE_REALTIME_NAME;
        warnsplit = new WarnSplitter(tab, TABPAGE_NAME[tabpages_num], this, -1, 0);
        tab->insertTab(tabpages_num, warnsplit, QIcon(QString(":light-off.png")), TABPAGE_NAME[tabpages_num]);
        m_WarnSplitterMap[tabpages_num] = warnsplit;
        tabpages_num++;
        for (i = 0; i < warn_level_num; i++)
        {
            TABPAGE_NAME[tabpages_num] = Transcoding::getInstance()->trans_coding(LevelDefine[i].name, Gbk_Data);
            warnsplit = new WarnSplitter(tab, TABPAGE_NAME[tabpages_num], this, tabpages_num, 1);
            tab->insertTab(tabpages_num + i, warnsplit, QIcon(QString(":light-off.png")), TABPAGE_NAME[tabpages_num]);
            m_WarnSplitterMap[tabpages_num] = warnsplit;
            tabpages_num++;
        }
        for (i = 0; i < MAX_WARN_NUM; i++)
        {
            if (WarnDefine[i].add_tab == 1)
            {
                TABPAGE_NAME[tabpages_num] = QString(WarnDefine[i].name);
                warnsplit = new WarnSplitter(tab, TABPAGE_NAME[tabpages_num], this, tabpages_num, 1);
                tab->insertTab(tabpages_num, warnsplit, QIcon(QString(":light-off.png")), TABPAGE_NAME[tabpages_num]);
                m_WarnSplitterMap[tabpages_num] = warnsplit;
                WarnDefine[i].tabpage = tabpages_num;
                tabpages_num++;
            }
        }

        // 推理结果
        if (tl_flag)
        {
            TABPAGE_NAME[tabpages_num] = TABPAGE_RESULT_NAME;
            warnsplit = new WarnSplitter(tab, TABPAGE_NAME[tabpages_num], this, tabpages_num, 0);
            tab->insertTab(tabpages_num, warnsplit, QIcon(QString(":light-off.png")), TABPAGE_NAME[tabpages_num]);
            m_WarnSplitterMap[tabpages_num] = warnsplit;
            result_tabpage = tabpages_num;
            tabpages_num++;
            strcpy(LevelDefine[WARN_LEVEL_RESULT - 1].name, TABPAGE_RESULT_NAME.toAscii().data());
        }

        // 检修信息
        TABPAGE_NAME[tabpages_num] = TABPAGE_EXAMINE_NAME;
        warnsplit = new WarnSplitter(tab, TABPAGE_NAME[tabpages_num], this, tabpages_num, 0);
        tab->insertTab(tabpages_num, warnsplit, QIcon(QString(":light-off.png")), TABPAGE_NAME[tabpages_num]);
        m_WarnSplitterMap[tabpages_num] = warnsplit;
        examine_tabpage = tabpages_num;
        tabpages_num++;

        // 未复归告警信息
        TABPAGE_NAME[tabpages_num] = TABPAGE_NOREVERT_NAME;
        warnsplit = new WarnSplitter(tab, TABPAGE_NAME[tabpages_num], this, tabpages_num, 0);
        tab->insertTab(tabpages_num, warnsplit, QIcon(QString(":light-off.png")), TABPAGE_NAME[tabpages_num]);
        m_WarnSplitterMap[tabpages_num] = warnsplit;
        revert_tabpage = tabpages_num;
        tabpages_num++;
    }

    void MainView::save()
    {
        QString strTitle;
        int fileType;
        strTitle = QObject::tr("Save as", "保存文件为");
        if (access("../data/warn_save", F_OK) == -1)
        {
            // QMessageBox::warning(this,QObject::tr("Error","错误"), QObject::tr("The directory of 'warn_save' is not exist!","目录warn_save不存在!"), QMessageBox::Ok);
            //  return;

            // 创建文件夹
            QString str = QDir::currentPath();
            QStringList strlist = str.split("/");
            QString path = "";
            for (int i = 0; i < strlist.count(); i++)
            {
                if (i < strlist.count() - 1)
                {
                    path += strlist.at(i) + "/";
                }
                else
                {
                    path += "data/warn_save";
                }
            }

            QDir dir(path);
            if (!dir.exists())
            {
                dir.mkdir(path);
            }
        }

        QString fname;
        QStringList filters;
        QStringList fnamelist;
        filters << QObject::tr("XLS file (*.xls)", "XLS文件 (*.xls)")
                << QObject::tr("TXT file (*.txt)", "TXT文件 (*.txt)")
                << QObject::tr("PDF file (*.pdf)", "PDF文件 (*.pdf)");
        QFileDialog dialog(this, strTitle);
        dialog.setFilters(filters);
        dialog.setDirectory(QDir("../data/warn_save"));
        dialog.setAcceptMode(QFileDialog::AcceptSave);
        dialog.setReadOnly(true);
        dialog.setLabelText(QFileDialog::Accept, QObject::tr("Save", "保存"));
        if (dialog.exec())
        {
            fnamelist = dialog.selectedFiles();
            if (fnamelist.size() == 1)
                fname = fnamelist.at(0);
            else
                return;
        }
        if (fname.isEmpty() == true)
            return;
        QString filter = dialog.selectedFilter();
        if (filter.contains("xls"))
            fileType = 0;
        else if (filter.contains("txt"))
            fileType = 1;
        else if (filter.contains("pdf"))
            fileType = 2;
        if (fileType == 0)
        {
            if (fname.endsWith(XLSTYPE) == false)
            {
                fname += XLSTYPE;
            }
        }
        else if (fileType == 1)
        {
            if (fname.endsWith(TXTTYPE) == false)
            {
                fname += TXTTYPE;
            }
        }
        else if (fileType == 2)
        {
            if (fname.endsWith(PDFTYPE) == false)
            {
                fname += PDFTYPE;
            }
        }
        m_SaveFileName = fname;
        m_CurrentTabOrder = tab->currentIndex();
        if (if_split_win)
            warnsplit->m_allView->saveFile(fileType);
        warnsplit->m_ackView->saveFile(fileType);
        statusBar()->showMessage(QObject::tr("Saved '%1'", "已保存 '%1'").arg(m_SaveFileName), 6000);
    }

