    void MainView::createMenus()
    {
        fileMenu = menuBar()->addMenu(tr("File(&F)", "文件(&F)"));
        fileMenu->addAction(saveAct);
        fileMenu->addAction(printAct);

        editMenu = menuBar()->addMenu(tr("Edit(&E)", "编辑(&E)"));
        editMenu->addAction(ackAct);
        editMenu->addAction(clearAckAct);
        editMenu->addAction(stopAct);
        editMenu->addSeparator();
        if (if_split_win)
        {
            editMenu->addAction(showAckViewAct);
            editMenu->addAction(showAllViewAct);
            editMenu->addSeparator();
        }
        editMenu->addAction(hisAct);

        optionMenu = menuBar()->addMenu(tr("Option(&O)", "选项(&O)"));
        optionMenu->addAction(settingAct);
    }

