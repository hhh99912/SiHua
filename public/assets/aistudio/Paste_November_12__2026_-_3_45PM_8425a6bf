    void MainView::explainReport(char *buffer)
    {
        int num, length;
        int counter = 0, number;
        WarnStruct tmpwarn;
        int RetCode;
        char flag = 0;
        char is_gz = 0;
        int repos_no = 0;
        int flag1, flag2;
        char alias[MAX_ALIAS_LEN];
        int current_id;
        int has_detail = 0;
        QString str_msg_string = "";

        num = getBuf.get_int(buffer + counter);
        counter += sizeof(int);

        if (num <= 0)
            return;
        // 新收到消息后自动定位至所有厂站
        m_AutoSelFac = true;
        m_AutoSelFacId = -1;

        // 时序页面light
        m_TabNeedLight[0] = true;
        for (number = 0; number < num; number++)
        {
            if ((number + 1) % 100 == 0)
            {
                qApp->processEvents();

                usleep(1 * 1000);
            }
            tmpwarn.repostype = 0;
            tmpwarn.gztype = 0;
            tmpwarn.confirm = 0;
            tmpwarn.no = -1;
            tmpwarn.status = -1;
            tmpwarn.value = -1;
            tmpwarn.result[0] = 0;
            tmpwarn.host[0] = 0;
            tmpwarn.oper[0] = 0;
            tmpwarn.mon[0] = 0;

            tmpwarn.type = getBuf.get_int(buffer + counter);

            if (tmpwarn.type >= 0 && tmpwarn.type < MAX_WARN_NUM)
            {
                tmpwarn.level = ShowArray2[tmpwarn.type];
                tmpwarn.customized_group = ShowArray2[tmpwarn.type];
            }
            else
            {
                tmpwarn.level = WARN_LEVEL_1;
                tmpwarn.customized_group = WARN_LEVEL_1;
            }
            tmpwarn.my_type = ShowArray[tmpwarn.type];
            // qDebug() << "tmpwarn.my_type1="<< ShowArray[tmpwarn.type]<<tmpwarn.type;

            if (WarnDefine[tmpwarn.my_type].add_tab == 1)
                m_TabNeedLight[WarnDefine[tmpwarn.my_type].tabpage] = true;

            //		printf("warn_type = %d warn_my_type = %d,warn_level=%d\n",tmpwarn.type,tmpwarn.my_type,tmpwarn.level);

            has_detail = 0;
            counter += sizeof(int);
            tmpwarn.no = getBuf.get_int(buffer + counter);
            counter += sizeof(int);
            length = getBuf.get_int(buffer + counter);
            if ((tmpwarn.no & 0x8000) != 0 && tmpwarn.no != -1)
                has_detail = 1;
            tmpwarn.no = tmpwarn.no & 0x7FFF;

            counter += sizeof(int);
            memcpy(tmpwarn.string, buffer + counter, length);
            counter += length;
            if (length > MAX_CHAR)
                length = MAX_CHAR;
            tmpwarn.string[length] = '\0';

            // continue;

            tmpwarn.fac_id = getBuf.get_int(buffer + counter);
            counter += sizeof(int);
            tmpwarn.key_id = getBuf.get_int(buffer + counter);
            counter += sizeof(int);
            tmpwarn.field_id = getBuf.get_short(buffer + counter);
            counter += sizeof(short);
            tmpwarn.value = getBuf.get_int(buffer + counter);
            counter += sizeof(int);

            if (has_detail)
            {

                tmpwarn.result[0] = '\0';
                memcpy(tmpwarn.result, buffer + counter, 64);
                tmpwarn.result[63] = '\0';
                counter += 64;
                memcpy(tmpwarn.host, buffer + counter, 32);
                tmpwarn.host[31] = '\0';
                counter += 32;
                memcpy(tmpwarn.oper, buffer + counter, 32);
                tmpwarn.oper[31] = '\0';
                counter += 32;

                strcat(tmpwarn.string, " ");
                strlcat(tmpwarn.string, tmpwarn.result, MAX_CHAR);
                //	printf("result=%s,host=%s,oper=%s\n",tmpwarn.result,tmpwarn.host,tmpwarn.oper);

                //			memcpy(tmpwarn.mon, buffer+counter, 32);
                //			tmpwarn.mon[31]='\0';
                //			counter += 32;
            }
            //		printf("keyid=%d warn_string %s \n",tmpwarn.key_id,tmpwarn.string);

            // if (tmpwarn.type==WARN_TYPE_RLY_EVENT || tmpwarn.type==WARN_TYPE_RLY_WARN  || tmpwarn.type==WARN_TYPE_RLY_DIAG )
