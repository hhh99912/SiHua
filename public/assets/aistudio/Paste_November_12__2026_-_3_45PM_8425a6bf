    void MainView::clear_ack()
    {
        if (!m_UserLoginFlag)
        {
            QMessageBox::warning(this, QObject::tr("Not logging in", "您未登录"),
                                 tr("Sorry,you are currently logged out!\n\nPlease the logging juniors clearing.", "对不起，您还没有登录!\n\n请您登录后再清除。"),
                                 QMessageBox::Ok);
            return;
        }
        if (!m_bRefreshWarn)
        {
            QMessageBox::warning(this, tr("Notice", "提示"), tr("Please restore refreshing before operating!\n", "请恢复刷新状态后操作!\n"),
                                 QMessageBox::Ok);
            return;
        }

        int ret = QMessageBox::question(this, tr("Remove the confirmed information", "清除已确认信息"),
                                        tr("Are you sure to remove the confirmed alarming information?", "您确定要清除已确认的告警信息吗?"),
                                        QMessageBox::Yes | QMessageBox::Default,
                                        QMessageBox::No,
                                        QMessageBox::Cancel | QMessageBox::Escape);
        if (ret == QMessageBox::Yes)
        {
            // 清除已确认信息
            if (GetCount2() < 0)
                return;
            int i, j;

            int begin = 0, end = item_end;
            if (item_has_full == 1)
            {
                if (item_end == 0)
                {
                    begin = 0;
                    end = MAX_LINES;
                }
                else
                {
                    begin = item_end;
                    end = begin + MAX_LINES;
                }
            }
            for (i = begin; i < end; i++)
            {
                j = i % MAX_LINES;
                if (WarnDefine[m_WarnRecMessage[j].my_type].flag == 0)
                    continue;
                if (m_WarnRecMessage[j].flag == 0)
                    continue;
                // 判断已经确认的消息并且在当前页面中
                // 或者当前面为时序信息时可以全部清除
                if ((m_WarnRecMessage[j].confirm_flag == 0) && (m_WarnRecMessage[j].confirm == 1) && (m_WarnRecMessage[j].customized_group == m_CurrentTabOrder || (WarnDefine[m_WarnRecMessage[j].my_type].tabpage == m_CurrentTabOrder) || m_CurrentTabOrder == 0))
                    m_WarnRecMessage[j].confirm_flag = 1;
            }
            if (if_split_win)
                warnsplit->m_allView->resize1();
            warnsplit->m_ackView->resize1();
        }
    }

    void MainView::ack_all()
    {
        if (!m_UserLoginFlag)
        {
            QMessageBox::warning(this, QObject::tr("Not logging in", "您未登录"),
                                 tr("Sorry,you are currently logged out!\n\nPlease the logging juniors an acknowledgement.", "对不起，您还没有登录!\n\n请您登录后再确认。"),
                                 QMessageBox::Ok);
            return;
        }
        if (!GetCertainMngPrivFlag(PRIV_GRAPH_YX_DW)) // zq add
        {
            QMessageBox::warning(this, QObject::tr("Not sigal confirm privilege", "您没有遥信对位权限"),
                                 tr("Sorry,you have no privilege of signal confirm!\n", "对不起，您没有遥信对位权限!\n"),
                                 QMessageBox::Ok);
            return;
        }
        int i;
        // 如果程序还没有收到消息就不刷新
        if (m_FirstStart)
        {
            return;
        }
        // 确认所有告警信息
        if (m_icurFac.size() != 0 || m_icurBay.size() != 0)
        {
            select_yx_unflash(); // zq add
        }
        else
        {
            all_yx_unflash();
        }
        for (i = 0; i < MAX_LINES; i++)
        {
            if (m_WarnRecMessage[i].is_gz > 0 && m_ConfirmGzp == false)
            {
                continue;
            }
            if (m_icurFac.size() != 0 || m_icurBay.size() != 0)
            {
                if (m_icurFac.size() != 0 && m_icurFac.contains(m_WarnRecMessage[i].fac_id) == false)
                {
                    continue;
                }
                if (m_icurBay.size() != 0 && m_icurBay.contains(m_WarnRecMessage[i].bay_id) == false)
                {
                    continue;
                }
                m_WarnRecMessage[i].confirm = 1;
            }
            else
            {
                m_WarnRecMessage[i].confirm = 1;
            }
        }
        if (m_IfSoudcut)
        { // zq add
            //        QString cmd;
            //        cmd = "../exe/send_report -sound_cut";
            //        QProcess::startDetached(cmd);

            int ret_code = smart_warn_info.dnet_send_message(DNET_REPORT_POINT_TO_POINT,
                                                             DNET_SOUND_CUT, DNET_SERVER_HOST, "svc_scada_server",
                                                             NULL, 0);
            // qDebug() << "stop sound" << ret_code;
        }
        refresh_flag = 1;
    }

